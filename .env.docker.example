# HTTP-first на тестовий Droplet (django-droplet-http-first).
# Скопіювати на сервері: cp .env.docker.example .env
# Замінити SECRET_KEY і POSTGRES_PASSWORD. Не комітити .env.
# У живому .env ЗАБОРОНЕНО лишати токен DROPLET_IP.

DJANGO_SETTINGS_MODULE=config.settings.production
DEBUG=False
SECRET_KEY=CHANGE-ME-generate-with-get_random_secret_key

# Реальний IPv4, не літерал DROPLET_IP. `web` — internal healthcheck.
ALLOWED_HOSTS=143.244.172.204,127.0.0.1,localhost,web
CSRF_TRUSTED_ORIGINS=http://143.244.172.204

# HTTP-тест: інакше кошик/адмінка не тримають сесію (ERR-118).
SECURE_SSL=False

POSTGRES_DB=euromaxi
POSTGRES_USER=euromaxi
POSTGRES_PASSWORD=CHANGE-ME-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# SEC-08: не лишати /admin/ на проді
ADMIN_URL=emx-manage/

MONOBANK_TOKEN=
MONOBANK_WEBHOOK_SECRET=
NOVA_POSHTA_API_KEY=

DEFAULT_EUR_UAH_RATE=0
DEFAULT_MARKUP_PERCENT=0

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=
