# Скопіювати у .env та заповнити реальними значеннями. .env НІКОЛИ не комітиться.

DJANGO_SETTINGS_MODULE=config.settings.develop
SECRET_KEY=change-me-to-a-random-50-char-string
# Локально. На Droplet HTTP-first — див. .env.docker.example (IP, не DROPLET_IP).
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (production; локально можна не заповнювати — тоді develop.py бере SQLite)
POSTGRES_DB=euromaxi
POSTGRES_USER=euromaxi
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Адмінка не на /admin/ (SEC-08) — задати власний шлях перед продакшн-релізом
ADMIN_URL=admin/

# Після SSL: https://домен. HTTP-тест по IP: http://143.244.172.204 (див. .env.docker.example)
CSRF_TRUSTED_ORIGINS=https://euromaxi.ua,https://www.euromaxi.ua

# Monobank Acquiring API — токен від клієнта, доки відсутній: без нього оплата в sandbox-режимі
MONOBANK_TOKEN=
MONOBANK_WEBHOOK_SECRET=

# Нова Пошта API — ключ від клієнта, доки відсутній: доставка у stub-режимі (Фаза 0.5)
NOVA_POSHTA_API_KEY=

# Перерахунок EUR netto -> UAH роздрібна (management-команда recalc_prices)
DEFAULT_EUR_UAH_RATE=0
DEFAULT_MARKUP_PERCENT=0

# Продакшн-пошта (контактна форма)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=

# True лише з HTTPS. HTTP-first на Droplet: False (.env.docker.example), інакше кошик/адмінка не логінять.
SECURE_SSL=True
